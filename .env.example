# Clé OpenAI : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-votre-cle-api-ici

# Clé Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=votre-cle-gemini-ici

# Modèles (optionnel)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TRANSLATE_MODEL=gpt-realtime-translate
# GEMINI_MODEL=gemini-3.8-live
# AUDIO pour les modèles "native audio" (texte via transcription), TEXT sinon
# GEMINI_RESPONSE_MODALITY=AUDIO

# Serveur (optionnel). HOST=127.0.0.1 pour interdire l'accès depuis le réseau local.
PORT=3000
# HOST=0.0.0.0
